{
  "name": "glass-effect",
  "version": "1.0.0",
  "description": "Apple-inspired Liquid Glass for React — real optical refraction, chromatic aberration, and frosted materials.",
  "type": "module",
  "license": "MIT",
  "author": "Glass Effect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ibrahimkhan799/Glass-Effect.git"
  },
  "homepage": "https://github.com/Ibrahimkhan799/Glass-Effect#readme",
  "keywords": [
    "react",
    "glass",
    "liquid-glass",
    "glassmorphism",
    "apple",
    "refraction",
    "backdrop-filter",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && cp src/styles.css dist/styles.css",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  }
}
